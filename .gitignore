# Publish only intentional workspace files; preserve unrelated local projects.
/*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/.mcp.json
!/opencode.json
# MCP servers for Codex and Pi; their other project files stay local.
!/.codex/
/.codex/*
!/.codex/config.toml
!/.pi/
/.pi/*
!/.pi/mcp.json
!/flake.nix
!/flake.lock
!/justfile
!/README.md
!/cmake/
!/repros/
!/.github/

# Even in tracked directories, generated files and credentials stay local.
**/__pycache__/
**/.venv/
**/.DS_Store
**/.env
**/.env.*
**/*.pem
**/*.key
**/Output/
**/*.pyc
