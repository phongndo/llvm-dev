# Called after project(LLVM). Defer until LLVM has declared its test targets.
# Reuse upstream's dependency graph instead of maintaining a list of test tools.
function(llvm_dev_test_dependencies)
  foreach(suite IN ITEMS llvm clang mlir clang-tools)
    if(suite STREQUAL "clang-tools")
      set(check_target check-clang-extra)
    else()
      set(check_target check-${suite})
    endif()
    if(TARGET ${check_target})
      get_target_property(dependencies ${check_target} MANUALLY_ADDED_DEPENDENCIES)
      add_custom_target(llvm-dev-${suite}-test-depends)
      if(dependencies)
        add_dependencies(llvm-dev-${suite}-test-depends ${dependencies})
      endif()
    endif()
  endforeach()
endfunction()
cmake_language(DEFER CALL llvm_dev_test_dependencies)
