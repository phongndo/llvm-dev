{
  "mcpServers": {
    "alive2": {
      "command": "nix",
      "args": [
        "develop",
        "${HOME}/code/llvm-dev",
        "--command",
        "just",
        "--justfile",
        "${HOME}/code/llvm-dev/justfile",
        "alive-mcp"
      ]
    },
    "godbolt": {
      "type": "http",
      "url": "https://godbolt.org/mcp"
    }
  }
}
